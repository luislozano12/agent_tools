# Copia este archivo como .env y rellena los valores de UN proveedor.
# El archivo .env no se sube a git; las variables ya definidas en tu terminal tienen prioridad.

# --- Proveedor ---
# anthropic | azure. Si lo dejas vacío se elige según las claves definidas
# (Anthropic si hay clave de Anthropic; si no, Azure).
AGENTE_PROVEEDOR=

# --- Anthropic (Claude) ---
ANTHROPIC_API_KEY=

# --- Azure OpenAI ---
# Endpoint del recurso, p. ej. https://mi-recurso.openai.azure.com
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
# Nombre del despliegue (no del modelo) que usará el agente principal.
AZURE_OPENAI_DEPLOYMENT=
# Opcional: despliegue más barato para leer las fuentes. Vacío = el principal.
AZURE_OPENAI_DEPLOYMENT_LECTOR=
# Opcional: versión de la API. Vacío = 2024-10-21.
OPENAI_API_VERSION=

# --- General ---
# Opcional: correo o URL de contacto para el User-Agent. Wikipedia lo exige.
AGENTE_CONTACTO=
